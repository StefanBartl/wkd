---
import { getCollection } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import CommitLine from '../../components/CommitLine.astro';
import Demo from '../../components/Demo.astro';
import ShotComposite from '../../components/ShotComposite.astro';
import Shots from '../../components/Shots.astro';
import { combosFor } from '../../lib/combos';
import { categoryLabel, lazySnippet } from '../../lib/format';
import { href } from '../../lib/site';
import Shell from '../../skins/modern/Shell.astro';

export async function getStaticPaths() {
  const plugins = await getCollection('plugins');
  // Passed through as a prop (not re-fetched per page below) so all ~38
  // generated pages share the one collection read from getStaticPaths.
  return plugins.map((plugin) => ({
    params: { id: plugin.id },
    props: { plugin, allPlugins: plugins },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { plugin, allPlugins } = Astro.props as Props;
const d = plugin.data;
const page = `p/${plugin.id}`;
// Let the huge headline break between name and suffix instead of mid-word.
const [nameBase, nameSuffix] = d.name.endsWith('.nvim')
  ? [d.name.slice(0, -5), '.nvim']
  : [d.name, ''];
const combos = combosFor(plugin.id);
const nameOf = (slug: string): string => allPlugins.find((p) => p.id === slug)?.data.name ?? slug;
---

<Shell page={page} title={`${d.name} — wkd`} description={d.tagline}>
  {/* data-pagefind-*: this (modern) page is the one Pagefind indexes for the plugin. */}
  <article class="m-plugin" data-pagefind-body data-pagefind-meta={`title:${d.name}`}>
    <header class="m-plugin-head">
      <p class="m-kicker">
        <b data-pagefind-filter="category">{categoryLabel(d.category)}</b> ·
        <span class="m-status" data-status={d.status} data-pagefind-filter="status">{d.status}</span>
        {d.nvimMin ? <span data-pagefind-ignore> · Neovim {d.nvimMin}+</span> : null}
        <span data-pagefind-ignore> · {d.commitCount} commits</span>
      </p>
      <h1 class="display display--name" data-kinetic>
        {nameBase}<wbr /><span class="m-suffix">{nameSuffix}</span>
      </h1>
      <p class="m-lede">{d.description}</p>
      <p class="m-actions" data-pagefind-ignore>
        <a class="m-btn" data-primary href={d.url} rel="noopener">Repository</a>
        <a class="m-btn" href={`${d.url}#readme`} rel="noopener">README</a>
        {d.hasVimdoc ? <a class="m-btn" href={href(`p/${plugin.id}/help`)} data-nav={`p/${plugin.id}/help`}>:help</a> : null}
      </p>
    </header>

    {d.demos.length > 0 ? <Demo slug={plugin.id} demos={d.demos} skin="modern" /> : null}
    {
      /* T6: ui.nvim's right-click-menu/tabline/statusline shots as one
         composite instead of a plain gallery -- opt-in per slug, since the
         composite is meant for a curated, matching set of shots, not any
         plugin's arbitrary screenshot count. Empty until public/shots/ui/
         actually has shots.json (Stefan's screenshots, not automatable). */
      plugin.id === 'ui' ? (
        d.shots.length > 0 && <ShotComposite slug={plugin.id} shots={d.shots} />
      ) : d.shots.length > 0 ? (
        <Shots slug={plugin.id} shots={d.shots} skin="modern" />
      ) : null
    }

    <div class="m-cols">
      <section data-pagefind-ignore>
        <h2 class="m-h2">Install</h2>
        <pre class="code"><code>{lazySnippet(d.owner, d.name)}</code></pre>
        {d.statusNote ? <p class="m-kicker">{d.statusNote}</p> : null}
      </section>
      <section>
        <h2 class="m-h2">Documentation</h2>
        <ul class="m-list">
          {
            d.docs.map((f) => (
              <li>
                <a href={`${d.url}/blob/HEAD/docs/${encodeURIComponent(f)}`} rel="noopener">docs/{f}</a>
              </li>
            ))
          }
          {d.docs.length === 0 ? <li>See the README.</li> : null}
        </ul>
      </section>
      <section data-pagefind-ignore>
        <h2 class="m-h2">Recent commits</h2>
        <ol class="m-list">
          {d.recent.slice(0, 8).map((c) => <CommitLine commit={c} skin="modern" showPlugin={false} />)}
        </ol>
      </section>
      {
        combos.length > 0 && (
          <section data-pagefind-ignore>
            <h2 class="m-h2">Combos</h2>
            <ul class="m-list m-combos">
              {combos.map((c) => (
                <li>
                  <span class="m-combo-chip" data-combo={c.id}>
                    <i class="m-combo-dot" aria-hidden="true" />
                    {c.name}
                  </span>
                  <p class="m-combo-blurb">{c.blurb}</p>
                  <p class="m-combo-members">
                    {c.members
                      .filter((slug) => slug !== plugin.id)
                      .map((slug, i, arr) => (
                        <>
                          <a href={href(`p/${slug}`)} data-nav={`p/${slug}`}>
                            {nameOf(slug)}
                          </a>
                          {i < arr.length - 1 ? ', ' : ''}
                        </>
                      ))}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    {d.banner ? <pre class="m-banner" aria-hidden="true" tabindex="-1" data-pagefind-ignore>{d.banner}</pre> : null}
  </article>
</Shell>
