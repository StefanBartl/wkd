---
import { getCollection } from 'astro:content';
import CategoryFilter from '../components/CategoryFilter.astro';
import CommitLine from '../components/CommitLine.astro';
import registry from '../data/registry.json';
import { approx, byDateDesc, categoryLabel, pad2 } from '../lib/format';
import { href } from '../lib/site';
import Shell from '../skins/modern/Shell.astro';

const plugins = (await getCollection('plugins')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const activity = (await getCollection('activity')).sort(byDateDesc).slice(0, 10);
const features = plugins.reduce((n, p) => n + p.data.featureCount, 0);
const testFiles = plugins.reduce((n, p) => n + p.data.testFiles, 0);
// Counted per plugin: two plugins may define a tag of the same name.
const helpTags = plugins.reduce((n, p) => n + p.data.helpTagCount, 0);
const counts: Record<string, number> = {};
for (const p of plugins) counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;
const title = 'wkd — a family of Neovim plugins';
const description = `${plugins.length} Neovim plugins from one workshop: AI, editing, navigation, debugging, project tooling — one command each, one shared foundation.`;
---

<Shell page="" title={title} description={description}>
  <section class="m-hero">
    <p class="m-kicker">
      github.com/{registry.owner} · <b>{plugins.length} repositories</b>
    </p>
    <h1 class="display" data-kinetic>
      {plugins.length} plugins.<br />One <b>family</b>.
    </h1>
    <p class="m-lede">
      Neovim plugins that share one rule — one command, one concern — and one tested foundation.
      This site is generated from the repositories themselves: every tagline, status and commit
      below is read from the source.
    </p>
    <dl class="m-stats">
      <div><dt>plugins</dt><dd>{plugins.length}</dd></div>
      <div><dt>features</dt><dd>{approx(features)}</dd></div>
      <div><dt>help topics</dt><dd>{approx(helpTags)}</dd></div>
      <div><dt>test files</dt><dd>{approx(testFiles)}</dd></div>
    </dl>
  </section>

  <section class="ticker" aria-label="Latest commits across all plugins">
    <div class="ticker-label">live</div>
    <label class="ticker-pause">
      <input type="checkbox" id="ticker-pause" />
      pause
    </label>
    <div class="ticker-viewport">
    <div class="ticker-track">
      {
        /* The second copy only exists for the seamless loop: inert + aria-hidden
           keep it out of the tab order and the accessibility tree. */
        [...activity, ...activity].map((c, i) => {
          const dup = i >= activity.length;
          return (
            <a
              href={href(`p/${c.data.plugin}`)}
              data-nav={`p/${c.data.plugin}`}
              inert={dup || undefined}
              aria-hidden={dup ? 'true' : undefined}
            >
              <span class="cplug">{c.data.pluginName}</span>
              <span class="ctype">{c.data.type ?? '·'}</span>
              <span>{c.data.subject}</span>
            </a>
          );
        })
      }
    </div>
    </div>
  </section>

  <div class="home">
    <div class="m-filter">
      <CategoryFilter counts={counts} />
    </div>
    <section class="roster" aria-label="All plugins">
      {
        plugins.map((p, i) => (
          <a
            class="m-card"
            href={href(`p/${p.id}`)}
            data-nav={`p/${p.id}`}
            data-cat={p.data.category}
            data-astro-prefetch
          >
            <span class="m-card-head">
              <span>{pad2(i + 1)}</span>
              <span class="m-card-cat">{categoryLabel(p.data.category)}</span>
            </span>
            <strong class="m-card-name">{p.data.name}</strong>
            <span class="m-card-tag">{p.data.tagline}</span>
          </a>
        ))
      }
    </section>
  </div>

  <section class="m-plugin" aria-label="Recent activity">
    <h2 class="m-h2">Recent activity</h2>
    <ol class="m-list">
      {activity.map((c) => <CommitLine commit={c.data} skin="modern" />)}
    </ol>
    <p><a class="m-btn" href={href('activity')} data-nav="activity" data-astro-prefetch>Full stream</a></p>
  </section>
</Shell>
