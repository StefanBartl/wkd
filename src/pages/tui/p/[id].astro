---
import { getCollection } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import CommitLine from '../../../components/CommitLine.astro';
import { categoryLabel, lazySnippet } from '../../../lib/format';
import Shell from '../../../skins/tui/Shell.astro';

export async function getStaticPaths() {
  const plugins = await getCollection('plugins');
  return plugins.map((plugin) => ({ params: { id: plugin.id }, props: { plugin } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { plugin } = Astro.props as Props;
const d = plugin.data;
---

<Shell page={`p/${plugin.id}`} title={`${d.name} — .nvim`} description={d.tagline} cmd={`help ${plugin.id}`}>
  {d.banner ? <pre class="banner" aria-hidden="true">{d.banner}</pre> : null}
  <h1 class="tui-h1">{d.name}</h1>
  <p class="tui-p">{d.description}</p>

  <dl class="tui-kv">
    <dt>status</dt>
    <dd>{d.status}{d.statusNote ? <span class="tui-dim"> — {d.statusNote}</span> : null}</dd>
    <dt>category</dt>
    <dd>{categoryLabel(d.category)}</dd>
    {d.nvimMin ? <dt>neovim</dt> : null}
    {d.nvimMin ? <dd>{d.nvimMin}+</dd> : null}
    <dt>repo</dt>
    <dd><a href={d.url} rel="noopener">{d.url.replace('https://', '')}</a></dd>
    <dt>commits</dt>
    <dd>{d.commitCount}</dd>
    {d.hasVimdoc ? <dt>help</dt> : null}
    {d.hasVimdoc ? <dd><a href={`${d.url}/tree/main/doc`} rel="noopener">:help {plugin.id}</a></dd> : null}
  </dl>

  <h2 class="tui-h2">install</h2>
  <pre class="tui-code"><code>{lazySnippet(d.owner, d.name)}</code></pre>

  {d.docs.length > 0 ? <h2 class="tui-h2">docs/</h2> : null}
  {
    d.docs.length > 0 ? (
      <ul class="tui-list">
        {d.docs.map((f) => (
          <li>
            <a href={`${d.url}/blob/main/docs/${f}`} rel="noopener">{f}</a>
          </li>
        ))}
      </ul>
    ) : null
  }

  <h2 class="tui-h2">git log</h2>
  <ol class="tui-list">
    {d.recent.map((c) => <CommitLine commit={c} skin="tui" showPlugin={false} />)}
  </ol>
</Shell>
