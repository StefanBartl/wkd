---
import { getCollection } from 'astro:content';
import CategoryFilter from '../../components/CategoryFilter.astro';
import CommitLine from '../../components/CommitLine.astro';
import { approx, byDateDesc, categoryLabel, pad2 } from '../../lib/format';
import { href } from '../../lib/site';
import Shell from '../../skins/tui/Shell.astro';

const plugins = (await getCollection('plugins')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const activity = (await getCollection('activity')).sort(byDateDesc).slice(0, 8);
const features = plugins.reduce((n, p) => n + p.data.featureCount, 0);
const counts: Record<string, number> = {};
for (const p of plugins) counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;
// figlet -f Slant wkd
const banner = [
  '           __       __',
  ' _      __/ /______/ /',
  '| | /| / / //_/ __  / ',
  '| |/ |/ / ,< / /_/ /  ',
  '|__/|__/_/|_|\\__,_/',
].join('\n');
---

<Shell page="" title="wkd — a family of Neovim plugins" description={`${plugins.length} Neovim plugins, one family.`} cmd="ls">
  <pre class="banner" aria-hidden="true" tabindex="-1">{banner}</pre>
  <h1 class="tui-h1">{plugins.length} plugins · {approx(features)} features · one family</h1>
  <p class="tui-p tui-dim">
    Generated from the repositories. Taglines, status and commits are read from source at build time.
  </p>

  <div class="home">
    <h2 class="tui-h2">plugins</h2>
    <div class="tui-filter">
      <span class="tui-dim" aria-hidden="true">:filter</span>
      <CategoryFilter counts={counts} />
    </div>
    <div class="tui-table">
      {
        plugins.map((p, i) => (
          <a href={href(`p/${p.id}`, 'tui')} data-nav={`p/${p.id}`} data-cat={p.data.category} data-astro-prefetch>
            <span class="idx">{pad2(i + 1)}</span>
            <span class="name">{p.data.name}</span>
            <span class="stat" data-status={p.data.status}>{p.data.status}</span>
            <span class="cat">{categoryLabel(p.data.category).toLowerCase()} — {p.data.tagline}</span>
          </a>
        ))
      }
    </div>
  </div>

  <h2 class="tui-h2">git log --all --oneline</h2>
  <ol class="tui-list">
    {activity.map((c) => <CommitLine commit={c.data} skin="tui" />)}
  </ol>
  <p class="tui-log"><b>:activity</b> for the full stream</p>
</Shell>
