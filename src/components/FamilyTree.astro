---
// The layered require() diagram, shared by the homepage's Tree view and
// /stack -- same markup, same data (src/lib/stack.ts treeLayout()), just
// mounted in two places so it doesn't drift into two implementations.
import { categoryLabel } from '../lib/format';
import { href } from '../lib/site';
import type { TreeLayout } from '../lib/stack';

interface Props {
  tree: TreeLayout;
}
const { tree } = Astro.props;
const treePos = new Map(tree.nodes.map((n) => [n.slug, n]));
---

<div class="m-tree-wrap">
  <svg
    class="m-tree"
    width={tree.width}
    height={tree.height}
    viewBox={`0 0 ${tree.width} ${tree.height}`}
    role="img"
    aria-label="Layered require() tree of the plugin family, roots at the bottom"
  >
    {
      tree.edges.map((e) => {
        const a = treePos.get(e.from);
        const b = treePos.get(e.to);
        if (!a || !b) return null;
        const midY = (a.y + b.y) / 2;
        return (
          <path
            class={e.optional ? 'm-tree-edge m-tree-edge-opt' : 'm-tree-edge'}
            d={`M ${a.x} ${a.y} C ${a.x} ${midY} ${b.x} ${midY} ${b.x} ${b.y}`}
          />
        );
      })
    }
    {
      tree.nodes.map((n) => (
        <a
          class={n.category === 'foundation' ? 'm-tree-node m-tree-node-root' : 'm-tree-node'}
          href={href(`p/${n.slug}`)}
        >
          <title>{`${n.name} -- ${categoryLabel(n.category)}`}</title>
          <circle cx={n.x} cy={n.y} r={n.category === 'foundation' ? 10 : 6} />
          <text x={n.x} y={n.y - 14}>{n.name}</text>
        </a>
      ))
    }
  </svg>
</div>
