---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/filter.css';
import { BOOT } from '../lib/boot';
import { BASE, href, otherSkin, type Skin } from '../lib/site';

interface Props {
  skin: Skin;
  /** site-relative page path without base or skin prefix, e.g. "p/cascade" */
  page: string;
  title: string;
  description: string;
}
const { skin, page, title, description } = Astro.props;
const other = otherSkin(skin);
const canonical = new URL(href(page), Astro.site);
---

<!doctype html>
<html lang="en" data-skin={skin}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content={skin === 'tui' ? 'dark' : 'light dark'} />
    {
      skin === 'tui' ? (
        <meta name="theme-color" content="#1a1b26" />
      ) : (
        <>
          <meta name="theme-color" content="#f1efe8" media="(prefers-color-scheme: light)" />
          <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
        </>
      )
    }
    {skin === 'modern' ? <Font cssVariable="--font-display" preload /> : null}
    <Font cssVariable="--font-mono" preload={skin === 'tui'} />
    {/* Emitted byte-for-byte from src/lib/boot.ts; its hash is in the CSP (astro.config.ts). */}
    <script is:inline set:html={BOOT}></script>
  </head>
  <body data-other-skin={other}>
    <slot />
    <script src="../scripts/prefs.ts"></script>
    <script src="../scripts/search.ts"></script>
  </body>
</html>
