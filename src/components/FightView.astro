---
import { CANVAS, FIGHTERS, MATCH_SECONDS } from '../lib/fight';
// T7: a minimal local-vs-AI fighting minigame, picked from the Grid/Tree/
// Orbit view switcher on the homepage. Server-side this only renders the
// character-select cards and the static HUD shell -- the match itself
// (src/scripts/fight.ts) is entirely client-side canvas, keyed off the
// data-fight-* hooks below.
import { fightPickCss } from '../lib/fightCss';
import { BASE } from '../lib/site';

// Per-fighter background-image/filter for the pick-card sprite preview
// can't be a `style="--x:…"` attribute: the site's CSP has no
// `style-src 'unsafe-inline'` (see hue.ts's data-hue for the same
// constraint elsewhere). fightPickCss(BASE) instead goes into a real
// <style> tag below, whose exact content is hashed into the CSP by
// astro.config.ts (fightPickCss is a pure function so both call sites
// produce byte-identical output -- same pattern as the boot script).
const pickCss = fightPickCss(BASE);
---

<div class="fight" data-fight>
  <div class="fight-select" data-fight-select>
    <p class="fight-lede">Pick your fighter. The arena is picked for you.</p>
    <div class="fight-roster">
      {
        FIGHTERS.map((f) => (
          <button type="button" class="fight-pick" data-fighter={f.id}>
            <span class="fight-pick-sprite" aria-hidden="true"></span>
            <span>{f.name}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="fight-arena" data-fight-arena hidden>
    <div class="fight-hud">
      <div class="fight-bar" aria-hidden="true">
        <div class="fight-bar-fill" data-fight-health="player"></div>
      </div>
      <div class="fight-hud-center">
        <div class="fight-record" data-fight-record aria-label="Wins and losses">0W 0L</div>
        <div class="fight-timer" data-fight-timer>{MATCH_SECONDS}</div>
      </div>
      <div class="fight-bar fight-bar-flip" aria-hidden="true">
        <div class="fight-bar-fill" data-fight-health="enemy"></div>
      </div>
    </div>
    <div class="fight-toolbar">
      <button type="button" class="fight-toolbtn" data-fight-music>Music: on</button>
      <button type="button" class="fight-toolbtn" data-fight-fullscreen>Fullscreen</button>
    </div>
    <div class="fight-canvas-wrap">
      <canvas data-fight-canvas width={CANVAS.w} height={CANVAS.h}></canvas>
      <div class="fight-intro" data-fight-intro aria-hidden="true">FIGHT!</div>
      <div class="fight-result" data-fight-result hidden>
        <p data-fight-result-text></p>
        <button type="button" class="m-btn" data-fight-again>Rematch</button>
      </div>
    </div>
    <div class="fight-touch" data-fight-touch aria-hidden="true">
      <div class="fight-touch-move">
        <button type="button" data-fight-action="left" aria-label="Move left">&larr;</button>
        <button type="button" data-fight-action="right" aria-label="Move right">&rarr;</button>
      </div>
      <div class="fight-touch-actions">
        <button type="button" data-fight-action="jump" aria-label="Jump">&uarr;</button>
        <button type="button" data-fight-action="attack1" aria-label="Light attack">A</button>
        <button type="button" data-fight-action="attack2" aria-label="Heavy attack">B</button>
      </div>
    </div>
    <p class="fight-controls">
      <kbd>&larr;</kbd><kbd>&rarr;</kbd> move &middot; <kbd>&uarr;</kbd> jump &middot;
      <kbd>Space</kbd> light &middot; <kbd>X</kbd> heavy
    </p>
    <p class="fight-controls" data-fight-gamepad hidden>
      Gamepad: stick or d-pad move &middot; <kbd>A</kbd> jump &middot; <kbd>X</kbd> light &middot;
      <kbd>B</kbd> heavy
    </p>
    <p class="fight-controls" data-fight-core hidden>Sim core: Rust / WebAssembly</p>
  </div>
</div>

<style set:html={pickCss}></style>
