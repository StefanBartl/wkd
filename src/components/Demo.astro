---
import { BASE, type Skin } from '../lib/site';

// A plugin's demo recording, when the build found one in public/demos/
// (see demos/ and .github/workflows/demos.yml). Not autoplaying: the poster
// is the first paint, the video loads on demand.
interface Props {
  slug: string;
  demo: { webm: boolean; mp4: boolean; poster: boolean };
  skin: Skin;
}
const { slug, demo, skin } = Astro.props;
const url = (ext: string): string => `${BASE}demos/${slug}.${ext}`;
---

<figure class:list={['demo', skin === 'tui' ? 'tui-demo' : 'm-demo']}>
  <video
    controls
    muted
    loop
    playsinline
    preload="none"
    width="1100"
    height="620"
    poster={demo.poster ? url('png') : undefined}
    aria-label={`${slug}.nvim demo recording`}
  >
    {demo.webm ? <source src={url('webm')} type="video/webm" /> : null}
    {demo.mp4 ? <source src={url('mp4')} type="video/mp4" /> : null}
    Your browser cannot play this video.
  </video>
  <figcaption>
    recorded with VHS from <code>demos/{slug}.tape</code> in a clean Neovim — re-recorded weekly
  </figcaption>
</figure>
