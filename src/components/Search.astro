---
// One markup for both skins; each skin styles `.search*` in its own stylesheet.
// Behaviour lives in src/scripts/search.ts (loaded from Base.astro). Without
// scripting the whole form is hidden (html:not([data-js]) rule in tokens.css),
// so nobody meets a field whose submit the CSP's form-action 'none' blocks.
interface Props {
  placeholder?: string;
}
const { placeholder = 'search' } = Astro.props;
---

<form class="search" role="search" data-search autocomplete="off">
  <label class="search-label" for="search-q">
    <span class="search-prefix" aria-hidden="true"></span>
    <span class="visually-hidden">Search plugins</span>
  </label>
  <input
    class="search-input"
    id="search-q"
    type="search"
    name="q"
    placeholder={placeholder}
    autocomplete="off"
    spellcheck="false"
    aria-controls="search-panel"
    aria-describedby="search-status"
  />
  <div class="search-panel" id="search-panel" data-panel hidden>
    <p class="search-status" id="search-status" data-status role="status" aria-live="polite"></p>
    <ol class="search-results" data-results></ol>
    <p class="search-keys" aria-hidden="true">↑↓ move · ⏎ open · esc close</p>
  </div>
</form>
