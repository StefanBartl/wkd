# Shared recording settings, `Source`d by every demo tape. The terminal theme
# is the site's default TUI palette (tokyonight-night), the font the site's
# mono font (vhs-action ships JetBrains Mono).
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1100
Set Height 620
Set Padding 16
Set Framerate 30
Set TypingSpeed 60ms
Set CursorBlink false
Set Theme { "name": "tokyonight-night", "background": "#1a1b26", "foreground": "#c0caf5", "cursor": "#c0caf5", "selection": "#292e42", "black": "#15161e", "red": "#f7768e", "green": "#9ece6a", "yellow": "#e0af68", "blue": "#7aa2f7", "magenta": "#bb9af7", "cyan": "#7dcfff", "white": "#a9b1d6", "brightBlack": "#414868", "brightRed": "#f7768e", "brightGreen": "#9ece6a", "brightYellow": "#e0af68", "brightBlue": "#7aa2f7", "brightMagenta": "#bb9af7", "brightCyan": "#7dcfff", "brightWhite": "#c0caf5" }
